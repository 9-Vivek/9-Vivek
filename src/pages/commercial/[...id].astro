---
import { render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getVisibleCollection } from '../../lib/visibility';
export async function getStaticPaths() { return (await getVisibleCollection('commercial')).map(entry => ({ params: { id: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
const featureLink = { label: 'VS Code extension', text: 'Marketplace link forthcoming', href: '#extension', id: 'extension' };
---
<ContentLayout {...entry.data} featureLink={featureLink}><Content /></ContentLayout>
