---
import { render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getVisibleCollection } from '../../lib/visibility';
export async function getStaticPaths() { return (await getVisibleCollection('research')).map(entry => ({ params: { id: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<ContentLayout {...entry.data} featureLink={{ label: 'Whitepaper', text: 'Technical paper forthcoming', href: '#whitepaper', id: 'whitepaper' }}><Content /></ContentLayout>
